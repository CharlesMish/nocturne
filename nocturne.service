# Edit this file before installing it.
# Replace every YOUR_USER value with your Pi username (for example: pi).
# Sky weather location can be changed later from the in-app Settings panel.
# Optional Environment= lines below only change fallback defaults.
#
# Install:
#   sudo cp nocturne.service /etc/systemd/system/nocturne.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now nocturne
#
# Check on it:
#   systemctl status nocturne
#   journalctl -u nocturne -f
#
# Stop / restart:
#   sudo systemctl stop nocturne
#   sudo systemctl restart nocturne

[Unit]
Description=Nocturne sleep app
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=YOUR_USER
WorkingDirectory=/home/YOUR_USER/nocturne
# Optional Sky-mode fallback location settings:
# Environment=NOCTURNE_LAT=41.8781
# Environment=NOCTURNE_LON=-87.6298
# Environment=NOCTURNE_LOCATION_NAME=Chicago
# Environment=NOCTURNE_TIMEZONE=America/Chicago
# Environment=NOCTURNE_TEMPERATURE_UNIT=fahrenheit
ExecStart=/home/YOUR_USER/nocturne/.venv/bin/python run_nocturne.py --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
