# Edit this file before installing it.
# Replace every YOUR_USER value with your Pi username (for example: pi).
# Add optional Environment= lines below if you want custom location/weather config.
#
# Install:
#   sudo cp nocturne.service /etc/systemd/system/nocturne.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now nocturne
#
# Check on it:
#   systemctl status nocturne
#   journalctl -u nocturne -f
#
# Stop / restart:
#   sudo systemctl stop nocturne
#   sudo systemctl restart nocturne

[Unit]
Description=Nocturne sleep app
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=YOUR_USER
WorkingDirectory=/home/YOUR_USER/nocturne
# Optional Sky-mode location settings:
# Environment=NOCTURNE_LAT=35.4676
# Environment=NOCTURNE_LON=-97.5164
# Environment=NOCTURNE_LOCATION_NAME=Oklahoma City
ExecStart=/home/YOUR_USER/nocturne/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
