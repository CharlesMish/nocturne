{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nocturne-cmish-dev",
  "compatibility_date": "2026-08-28",
  "workers_dev": false,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "nocturne.cmish.dev",
      "custom_domain": true
    }
  ]
}
