{
  "name": "nocturne-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "verify": "node scripts/verify-build.mjs",
    "test": "npm run build && npm run verify",
    "cf:dry-run": "wrangler deploy --dry-run --strict",
    "check": "npm test && npm run cf:dry-run",
    "dev": "wrangler dev",
    "deploy:preview": "wrangler versions upload --preview-alias review --strict",
    "deploy": "wrangler deploy --strict"
  },
  "devDependencies": {
    "wrangler": "4.126.0"
  }
}
