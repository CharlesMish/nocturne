.venv/
__pycache__/
.DS_Store

# Generated release/review bundles
dist/
review_bundles/
verification-artifacts/
verification-logs/
nocturne-support-report.txt
/*.zip

# Root-level scratch media never belongs to the product package
/*.aac
/*.flac
/*.m4a
/*.mp3
/*.mp4
/*.ogg
/*.opus
/*.wav
/*.webm

sounds/*.mp3
sounds/*.wav
sounds/*.flac
sounds/*.ogg
sounds/*.m4a
sounds/*.opus
sounds/*.webm
sounds/MEDIA_MANIFEST.generated.json

# User radio tracks (any audio the user adds for Radio mode)
sounds/radio/*.mp3
sounds/radio/*.wav
sounds/radio/*.flac
sounds/radio/*.ogg
sounds/radio/*.m4a
sounds/radio/*.opus
sounds/radio/*.webm

# Local user manifest override (committed defaults live in media_sources.default.json)
media_sources.json
config/nocturne.json

# Curation intake/originals can contain large or unprocessed source files.
# Keep the directory documentation while ignoring every other inbox payload.
sounds/inbox/**
!sounds/inbox/**/
!sounds/inbox/**/README.md
provenance/originals/*
!provenance/originals/.gitkeep
